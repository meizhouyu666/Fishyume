{
  "name": "fishyume",
  "version": "0.2.1-alpha.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "fishyume": "dist/cli.js",
    "wf": "dist/cli.js"
  },
  "description": "Agent-native local control plane for durable AI workflows",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "directory": "wf"
  },
  "optionalDependencies": {
    "fishyume-engine-linux-x64": "0.2.1-alpha.1",
    "fishyume-engine-win32-x64": "0.2.1-alpha.1"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx src/**/*.test.ts src/**/*.test.tsx scripts/codex-host-mcp-smoke.test.mjs",
    "test:mcp-host": "node --test --import tsx src/integration/mcp-host-agent.test.ts",
    "test:mcp-tui": "node --test --import tsx src/integration/mcp-tui-concurrency.test.ts",
    "test:restart": "node --test --import tsx src/integration/control-plane-restart.test.ts",
    "smoke:codex-live": "npm run build && node scripts/codex-live-smoke.mjs",
    "smoke:codex-live:parallel": "npm run build && node scripts/codex-live-smoke.mjs --parallel",
    "smoke:codex-host-mcp": "npm run build && node scripts/codex-host-mcp-smoke.mjs",
    "smoke:codex-host-pty": "npm run build && node scripts/codex-host-mcp-smoke.mjs --pty-handoff",
    "smoke:codex-host-pty:auto": "npm run build && node scripts/codex-host-mcp-smoke.mjs --pty-handoff --auto-detach",
    "verify": "npm run typecheck && npm test && npm run build && npm run pack:audit && npm run pack:audit:real",
    "gallery": "tsx scripts/render-tui-gallery.ts",
    "pack:dry-run": "npm pack --dry-run",
    "pack:audit": "node scripts/audit-pack.mjs --dry-run",
    "pack:audit:real": "node scripts/audit-pack.mjs --real"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "clipanion": "^4.0.0-rc.4",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
